# KAAMSETU - Sovereign Digital Identity Platform Environment Configuration
# Template file. Never commit real secrets or production keys.

# ==============================================================================
# 1. Supabase Infrastructure (PostgreSQL 15+ & Row Level Security)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# 2. Cryptographic Credential Signing (RFC 8785 Canonical JSON + HMAC-SHA256)
# Minimum 32 random bytes (256 bits of entropy) required in production.
# Generate with: openssl rand -base64 32
# ==============================================================================
CREDENTIAL_SIGNING_KEY=generate-at-least-32-bytes-base64-secret-here
# Optional version-specific overrides for multi-version rotation (e.g. CREDENTIAL_SIGNING_KEY_V1)
# CREDENTIAL_SIGNING_KEY_V1=
# CREDENTIAL_SIGNING_KEY_V2=
ACTIVE_SIGNING_KEY_VERSION=v1
# Comma-separated list of retired or compromised signing key versions
REVOKED_SIGNING_KEY_VERSIONS=

# ==============================================================================
# 3. Privacy-Preserving Rate Limiting HMAC Secret
# Server-only. Independent from credential signing keys and service-role keys.
# Minimum 32 random bytes (256 bits of entropy) required in production.
# Generate with: openssl rand -base64 32
# ==============================================================================
RATE_LIMIT_HMAC_SECRET=generate-at-least-32-bytes-base64-secret-here
# Optional previous secret for zero-downtime rotation without dropping active lockouts:
# RATE_LIMIT_HMAC_SECRET_PREVIOUS=

# In production, rate limiting strictly fails closed against PostgreSQL auth_rate_limits.
# ENABLE_IN_MEMORY_RATE_LIMIT_MOCK is strictly for offline dev/test without database.
ENABLE_IN_MEMORY_RATE_LIMIT_MOCK=false

# ==============================================================================
# 4. SMS Provider Configuration (Production Phone OTP)
# Used by Supabase Auth / Twilio / MSG91 for real SMS dispatch
# ==============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ==============================================================================
# 5. Google Gemini API (Server-Side Only - Multilingual Voice & Skill Extraction)
# ==============================================================================
GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================================================
# 6. Application Configuration
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ==============================================================================
# 7. Hackathon / Demo Authentication Isolation Guard
# Set to true ONLY in local demo/evaluation sandbox.
# FATAL ERROR if enabled when NODE_ENV=production.
# ==============================================================================
ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
