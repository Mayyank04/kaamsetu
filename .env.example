# KAAMSETU - Sovereign Digital Identity Platform Environment Variables

# Supabase Infrastructure (PostgreSQL 15+ & Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cryptographic Credential Signing (RFC 8785 Canonical JSON + HMAC-SHA256)
# Minimum 32 characters (256 bits of entropy) required in production.
CREDENTIAL_SIGNING_KEY=generate-at-least-32-char-cryptographically-secure-secret-here
ACTIVE_SIGNING_KEY_VERSION=v1
# Comma-separated list of retired or compromised signing key versions
REVOKED_SIGNING_KEY_VERSIONS=

# Google Gemini API (Server-Side Only - Multilingual Voice & Skill Extraction)
GEMINI_API_KEY=your-gemini-api-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Rate Limiting Configuration
# In production, rate limiting strictly fails closed against PostgreSQL auth_rate_limits.
# ENABLE_IN_MEMORY_RATE_LIMIT_MOCK is strictly for offline dev/test without database.
ENABLE_IN_MEMORY_RATE_LIMIT_MOCK=false

# Hackathon / Demo Authentication Isolation Guard (Set to true ONLY in demo/evaluation sandbox)
# FATAL ERROR if enabled when NODE_ENV=production.
ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
