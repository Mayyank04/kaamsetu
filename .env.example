# KAAMSETU - Sovereign Digital Identity Platform Environment Variables

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API (Server-Side Only - Never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Hackathon / Demo Authentication Isolation Guard (Set to true ONLY in demo/evaluation sandbox)
ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
