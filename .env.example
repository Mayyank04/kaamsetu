# KAAMSETU — Environment Configuration Template
# All secret values must be supplied by the deployment environment.
# NEVER commit real credentials, private keys, or API tokens to source control.

# ==============================================================================
# 1. Supabase Infrastructure (PostgreSQL 15+ & Row Level Security)
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Direct PostgreSQL connection string for migrations and backend verification
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ==============================================================================
# 2. Cryptographic Credential Signing (Ed25519 & RFC 8785 Canonical JSON)
# ==============================================================================
# Master Ed25519 Private Key in PEM format (server-side only)
ED25519_ISSUER_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ED25519_ISSUER_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACTIVE_SIGNING_KEY_VERSION=v2026.1
REVOKED_SIGNING_KEY_VERSIONS=""

# HMAC Secret for legacy credential verification
CREDENTIAL_SIGNING_KEY=generate-at-least-32-bytes-base64-secret-here

# ==============================================================================
# 3. Privacy-Preserving Rate Limiting HMAC Secret
# Server-only. Minimum 32 random bytes (256 bits of entropy) required.
# ==============================================================================
RATE_LIMIT_HMAC_SECRET=generate-at-least-32-bytes-base64-secret-here
ENABLE_IN_MEMORY_RATE_LIMIT_MOCK=false

# ==============================================================================
# 4. Regional Operating Boundary & Classification (CLASS_B_CONTROLLED_ROLLOUT)
# ==============================================================================
PERMITTED_OPERATING_REGIONS="Guwahati Urban (Kamrup Metro, Assam),Shillong Urban (East Khasi Hills, Meghalaya)"
OPERATING_CLASSIFICATION=CLASS_B_CONTROLLED_ROLLOUT
PLATFORM_COMMISSION_AMOUNT=0.00

# ==============================================================================
# 5. External Partner Sandboxes (Testing & Evaluation)
# ==============================================================================
# SMS / OTP Provider (Twilio / Fast2SMS)
SMS_PROVIDER=sandbox
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Payment Gateway Sandbox (Razorpay / Cashfree)
PAYMENT_GATEWAY_PROVIDER=sandbox
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# DigiLocker Partner API (MeitY)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/auth/digilocker/callback

# ONDC / ONest Network Registry (Staging)
ONDC_REGISTRY_URL=https://staging.registry.ondc.org
ONDC_SUBSCRIBER_ID=kaamsetu.in
ONDC_UKID=kaamsetu-bpp-v1

# ==============================================================================
# 6. Google Gemini AI API (Server-Side Only - Multilingual Voice & Skill Extraction)
# ==============================================================================
GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================================================
# 7. Application Configuration
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ==============================================================================
# 8. Demo Persona Authentication Guard
# Set to true ONLY in local development / evaluation sandbox.
# Must be strictly false in production environments.
# ==============================================================================
ENABLE_DEMO_AUTH=true
NEXT_PUBLIC_ENABLE_DEMO_AUTH=true
